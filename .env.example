DATABASE_URL="postgresql://pulsedesk:pulsedesk@localhost:5434/pulsedesk?schema=public"

# Restricted, non-superuser role — created by the enable_rls migration.
# The running app uses ONLY this connection for tenant-scoped (RLS-protected) data.
APP_DATABASE_URL="postgresql://pulsedesk_app:pulsedesk_app_dev_password@localhost:5434/pulsedesk?schema=public"

PORT=3001

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"

# Refresh tokens are opaque, not JWTs — this TTL is applied manually when we store expires_at.
REFRESH_TOKEN_TTL_DAYS=30

# OpenFGA — run scripts/fga-bootstrap.ts once against a fresh OpenFGA instance
# to get STORE_ID/MODEL_ID values.
FGA_API_URL="http://localhost:8080"
FGA_STORE_ID=""
FGA_MODEL_ID=""

# How long a break-glass emergency grant stays valid before it must be re-requested.
BREAK_GLASS_TTL_HOURS=4

REDIS_URL="redis://localhost:6380"
HEART_RATE_ALERT_THRESHOLD=115
HEART_RATE_WINDOW_MINUTES=60
