generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  refreshTokens RefreshToken[]
  patients      Patient[]
  careTeams     CareTeam[]
  devices       Device[]
  alerts        Alert[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String
  passwordHash String   @map("password_hash")
  role         String   @default("clinician")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@map("users")
}

// A refresh token family is a chain of rotated tokens issued from one login.
// familyId is shared across the whole chain; rotatedFromId links a token to
// the token it replaced, so replay of a dead token can be traced back to its family.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tenantId      String    @map("tenant_id")
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id")
  rotatedFromId String?   @unique @map("rotated_from_id")
  revokedAt     DateTime? @map("revoked_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([familyId])
  @@map("refresh_tokens")
}

model Patient {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  devices       Device[]
  alerts        Alert[]
  careTeamLinks CareTeamPatient[]

  @@map("patients")
}

model CareTeam {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  members CareTeamMembership[]
  patients CareTeamPatient[]

  @@map("care_teams")
}

// Which clinicians (users) belong to which care team.
model CareTeamMembership {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  careTeamId String   @map("care_team_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  careTeam CareTeam @relation(fields: [careTeamId], references: [id])

  @@unique([careTeamId, userId])
  @@map("care_team_memberships")
}

// Which patients a care team covers. Many-to-many: a patient can have more
// than one covering team, a team covers many patients.
model CareTeamPatient {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  careTeamId String   @map("care_team_id")
  patientId  String   @map("patient_id")
  createdAt  DateTime @default(now()) @map("created_at")

  careTeam CareTeam @relation(fields: [careTeamId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])

  @@unique([careTeamId, patientId])
  @@map("care_team_patients")
}

model Device {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  patientId    String   @map("patient_id")
  serialNumber String   @map("serial_number")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([tenantId, serialNumber])
  @@map("devices")
}

model Alert {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  patientId  String    @map("patient_id")
  severity   String
  message    String
  status     String    @default("open")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@map("alerts")
}
