generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  refreshTokens RefreshToken[]
  patients      Patient[]
  careTeams     CareTeam[]
  devices       Device[]
  alerts        Alert[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String
  passwordHash String   @map("password_hash")
  role         String   @default("clinician")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@map("users")
}

// A refresh token family is a chain of rotated tokens issued from one login.
// familyId is shared across the whole chain; rotatedFromId links a token to
// the token it replaced, so replay of a dead token can be traced back to its family.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tenantId      String    @map("tenant_id")
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id")
  rotatedFromId String?   @unique @map("rotated_from_id")
  revokedAt     DateTime? @map("revoked_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([familyId])
  @@map("refresh_tokens")
}

// Minimal shape for now — this exists in Phase 2 solely so the mandatory
// tenant-isolation/RLS test has a real tenant-scoped table to prove against.
// Phase 3 adds the full CRUD surface (DTOs, care team relations, etc.) on top
// of this same table; it does not change tenant_id/RLS semantics.
model Patient {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("patients")
}
