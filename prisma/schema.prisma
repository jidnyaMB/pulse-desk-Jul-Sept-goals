generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  refreshTokens RefreshToken[]
  patients      Patient[]
  careTeams     CareTeam[]
  devices       Device[]
  alerts        Alert[]
  accessGrants  AccessGrant[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String
  passwordHash String   @map("password_hash")
  role         String   @default("clinician")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@map("users")
}

// A refresh token family is a chain of rotated tokens issued from one login.
// familyId is shared across the whole chain; rotatedFromId links a token to
// the token it replaced, so replay of a dead token can be traced back to its family.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tenantId      String    @map("tenant_id")
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id")
  rotatedFromId String?   @unique @map("rotated_from_id")
  revokedAt     DateTime? @map("revoked_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([familyId])
  @@map("refresh_tokens")
}

model Patient {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  devices       Device[]
  alerts        Alert[]
  careTeamLinks CareTeamPatient[]
  accessGrants  AccessGrant[]

  @@map("patients")
}

model CareTeam {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  members CareTeamMembership[]
  patients CareTeamPatient[]

  @@map("care_teams")
}

// Which clinicians (users) belong to which care team.
model CareTeamMembership {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  careTeamId String   @map("care_team_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  careTeam CareTeam @relation(fields: [careTeamId], references: [id])

  @@unique([careTeamId, userId])
  @@map("care_team_memberships")
}

// Which patients a care team covers. Many-to-many: a patient can have more
// than one covering team, a team covers many patients.
model CareTeamPatient {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  careTeamId String   @map("care_team_id")
  patientId  String   @map("patient_id")
  createdAt  DateTime @default(now()) @map("created_at")

  careTeam CareTeam @relation(fields: [careTeamId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])

  @@unique([careTeamId, patientId])
  @@map("care_team_patients")
}

model Device {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  patientId    String   @map("patient_id")
  serialNumber String   @map("serial_number")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([tenantId, serialNumber])
  @@map("devices")
}

model Alert {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  patientId  String    @map("patient_id")
  severity   String
  message    String
  status     String    @default("open")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@map("alerts")
}

// Outbox pattern: a Postgres write to care_team_memberships / care_team_patients
// and the corresponding OpenFGA tuple write can't be one atomic transaction
// across two different systems. So the intent to write/delete a tuple is
// recorded here, in the SAME transaction as the Postgres change that caused
// it — then a separate relay (OutboxRelayService) drains this table into
// OpenFGA, retrying until it succeeds. Postgres stays the source of truth
// even if OpenFGA is briefly unreachable.
model OutboxEvent {
  id           String    @id @default(uuid())
  userObject   String    @map("user_object")
  relation     String
  targetObject String    @map("target_object")
  operation    String // 'write' | 'delete'
  createdAt    DateTime  @default(now()) @map("created_at")
  processedAt  DateTime? @map("processed_at")
  lastError    String?   @map("last_error")

  @@map("outbox_events")
}

// Temporary access, expressed as a plain Postgres row rather than a stored
// OpenFGA tuple. Expiry/revocation is exact and instant because it's a
// database timestamp comparison, not something OpenFGA has to know about
// persistently — see AccessGrantsService.getValidContextualTuples(), which
// turns currently-valid rows into contextual tuples at check time only.
model AccessGrant {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id")
  patientId     String    @map("patient_id")
  relation      String // 'viewer' | 'editor'
  reason        String // e.g. 'on_call', 'break_glass'
  justification String?
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@map("access_grants")
}

// Minimal audit trail — only what Phase 4's break-glass requirement needs.
// Phase 6 formalizes this (trace_id, request_id, structured authorization
// decision/reason columns). No patient name/MRN/reading values here, ever.
model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  actorUserId  String   @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
