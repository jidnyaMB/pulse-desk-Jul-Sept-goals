generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  refreshTokens RefreshToken[]
  patients      Patient[]
  careTeams     CareTeam[]
  devices       Device[]
  alerts        Alert[]
  accessGrants  AccessGrant[]
  webhookEvents WebhookEvent[]
  readings      Reading[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String
  passwordHash String   @map("password_hash")
  role         String   @default("clinician")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@map("users")
}

// A refresh token family is a chain of rotated tokens issued from one login.
// familyId is shared across the whole chain; rotatedFromId links a token to
// the token it replaced, so replay of a dead token can be traced back to its family.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tenantId      String    @map("tenant_id")
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id")
  rotatedFromId String?   @unique @map("rotated_from_id")
  revokedAt     DateTime? @map("revoked_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([familyId])
  @@map("refresh_tokens")
}

model Patient {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  devices       Device[]
  alerts        Alert[]
  careTeamLinks CareTeamPatient[]
  accessGrants  AccessGrant[]
  readings      Reading[]

  @@map("patients")
}

model CareTeam {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  members CareTeamMembership[]
  patients CareTeamPatient[]

  @@map("care_teams")
}

// Which clinicians (users) belong to which care team.
model CareTeamMembership {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  careTeamId String   @map("care_team_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  careTeam CareTeam @relation(fields: [careTeamId], references: [id])

  @@unique([careTeamId, userId])
  @@map("care_team_memberships")
}

// Which patients a care team covers. Many-to-many: a patient can have more
// than one covering team, a team covers many patients.
model CareTeamPatient {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  careTeamId String   @map("care_team_id")
  patientId  String   @map("patient_id")
  createdAt  DateTime @default(now()) @map("created_at")

  careTeam CareTeam @relation(fields: [careTeamId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])

  @@unique([careTeamId, patientId])
  @@map("care_team_patients")
}

model Device {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  patientId    String   @map("patient_id")
  // Globally unique (not per-tenant): a device webhook arrives with only a
  // serial number and a signature, before we know which tenant it belongs
  // to — the serial number IS how we resolve the tenant, so it has to be
  // unambiguous across the whole system, the way real device serials are.
  serialNumber String   @unique @map("serial_number")
  // Per-device HMAC secret used to verify webhook signatures. Generated
  // once at device creation, returned in that response only — never
  // included in subsequent GET/list responses.
  hmacSecret   String   @map("hmac_secret")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  patient  Patient        @relation(fields: [patientId], references: [id])
  webhooks WebhookEvent[]
  readings Reading[]

  @@map("devices")
}

model WebhookEvent {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  deviceId       String    @map("device_id")
  externalEventId String   @map("external_event_id")
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at")
  processedAt    DateTime? @map("processed_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  device  Device   @relation(fields: [deviceId], references: [id])
  reading Reading?

  // The actual idempotency boundary: two webhook deliveries with the same
  // (deviceId, externalEventId) can never both succeed at INSERT time, no
  // matter how many times the vendor retries or how many requests race.
  @@unique([deviceId, externalEventId])
  @@map("webhook_events")
}

model Reading {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  patientId      String   @map("patient_id")
  deviceId       String   @map("device_id")
  webhookEventId String   @unique @map("webhook_event_id")
  heartRate      Int      @map("heart_rate")
  recordedAt     DateTime @map("recorded_at")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  device       Device       @relation(fields: [deviceId], references: [id])
  webhookEvent WebhookEvent @relation(fields: [webhookEventId], references: [id])

  @@map("readings")
}

model Alert {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  patientId  String    @map("patient_id")
  severity   String
  message    String
  status     String    @default("open")
  // Identifies WHAT kind of condition triggered this alert (e.g.
  // 'high_heart_rate'). Combined with a partial unique index (see the
  // alert_dedupe_partial_index migration) on (patientId, dedupeKey) WHERE
  // status = 'open', this makes "don't open a second alert for a condition
  // that's already open" a database guarantee, not an application check.
  dedupeKey  String?   @map("dedupe_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@map("alerts")
}

// Outbox pattern: a Postgres write to care_team_memberships / care_team_patients
// and the corresponding OpenFGA tuple write can't be one atomic transaction
// across two different systems. So the intent to write/delete a tuple is
// recorded here, in the SAME transaction as the Postgres change that caused
// it — then a separate relay (OutboxRelayService) drains this table into
// OpenFGA, retrying until it succeeds. Postgres stays the source of truth
// even if OpenFGA is briefly unreachable.
model OutboxEvent {
  id           String    @id @default(uuid())
  userObject   String    @map("user_object")
  relation     String
  targetObject String    @map("target_object")
  operation    String // 'write' | 'delete'
  createdAt    DateTime  @default(now()) @map("created_at")
  processedAt  DateTime? @map("processed_at")
  lastError    String?   @map("last_error")

  @@map("outbox_events")
}

// Temporary access, expressed as a plain Postgres row rather than a stored
// OpenFGA tuple. Expiry/revocation is exact and instant because it's a
// database timestamp comparison, not something OpenFGA has to know about
// persistently — see AccessGrantsService.getValidContextualTuples(), which
// turns currently-valid rows into contextual tuples at check time only.
model AccessGrant {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id")
  patientId     String    @map("patient_id")
  relation      String // 'viewer' | 'editor'
  reason        String // e.g. 'on_call', 'break_glass'
  justification String?
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@map("access_grants")
}

// Minimal audit trail — only what Phase 4's break-glass requirement needs.
// Phase 6 formalizes this (trace_id, request_id, structured authorization
// decision/reason columns). No patient name/MRN/reading values here, ever.
model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  actorUserId  String   @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// Proof artifact for cluster-safe scheduling: the scheduled sweep job writes
// exactly one row per tick (tickKey = the tick's timestamp, truncated to the
// minute). If N worker replicas were each running their own timer instead of
// sharing one BullMQ repeatable job, you'd see N rows per tick instead of 1 —
// that's the actual, checkable difference this table exists to prove.
model ScheduledJobRun {
  id       String   @id @default(uuid())
  tickKey  String   @unique @map("tick_key")
  runAt    DateTime @default(now()) @map("run_at")
  runByPid Int      @map("run_by_pid")

  @@map("scheduled_job_runs")
}
